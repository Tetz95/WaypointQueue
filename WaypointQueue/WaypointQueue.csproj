<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SDK-style project: builds with the .NET SDK (dotnet build), no Visual Studio
    MSBuild needed. Every .cs file in this folder is compiled, so new source files
    need no project entry.

    This branch (rr2026) builds for Railroader 2026.1 only; the Legacy version stays on the tetz branch.
    Build: dotnet build WaypointQueue/WaypointQueue.csproj  (installs into the 2026.1 home dir's Mods with ..\Info.json;
    -p:NoInstall=true builds without installing). Game paths come from Paths.user (..\..\Railroader.paths.props).
  -->
  <PropertyGroup>
    <RR>2026</RR>
  </PropertyGroup>
  <Import Project="..\Paths.user" Condition="Exists('..\Paths.user')" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WaypointQueue</AssemblyName>
    <RootNamespace>WaypointQueue</RootNamespace>
    <RR2026Ported>true</RR2026Ported>
    <UsesHarmony>true</UsesHarmony>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ModDirectory>$(RailroaderModsDir)\WaypointQueue</ModDirectory>
  </PropertyGroup>

  <!-- The game's own loader and assemblies; Harmony is our own (the game ships none). -->
  <Import Project="..\..\Railroader2026.refs.props" />

  <!-- Install with our Harmony beside the DLL. Delete before copying (Vortex may hardlink). Settings.xml there is
       left alone. -->
  <Target Name="InstallMod" AfterTargets="Build" Condition="Exists('..\Paths.user') And '$(NoInstall)' != 'true'">
    <MakeDir Directories="$(ModDirectory)" />
    <ItemGroup>
      <_InstallFiles Include="$(OutDir)$(AssemblyName).dll;$(OutDir)$(AssemblyName).pdb;$(OutDir)0Harmony.dll;..\Info.json" />
    </ItemGroup>
    <Delete Files="@(_InstallFiles->'$(ModDirectory)\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_InstallFiles)" DestinationFolder="$(ModDirectory)" />
  </Target>
</Project>
