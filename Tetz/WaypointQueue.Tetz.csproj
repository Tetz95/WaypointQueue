<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SDK-style build for the Tetz fork. It compiles the same sources as
    WaypointQueue/WaypointQueue.csproj, which needs Visual Studio's MSBuild,
    and installs the mod with Tetz/Info.json. The original project is left
    untouched so upstream changes merge cleanly.

    Build: dotnet build Tetz/WaypointQueue.Tetz.csproj
    The game install folder comes from Paths.user (RrInstallDir), as upstream.
  -->
  <Import Project="..\Paths.user" Condition="Exists('..\Paths.user')" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WaypointQueue</AssemblyName>
    <RootNamespace>WaypointQueue</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RrManagedDir>$(RrInstallDir)\Railroader_Data\Managed</RrManagedDir>
    <ModDirectory>$(RrInstallDir)\Mods\WaypointQueue</ModDirectory>
    <WqSource>..\WaypointQueue</WqSource>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(WqSource)\**\*.cs" Exclude="$(WqSource)\obj\**;$(WqSource)\bin\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UnityModManager" Version="0.32.4" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(RrManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Definition"><HintPath>$(RrManagedDir)\Definition.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="KeyValue.Runtime"><HintPath>$(RrManagedDir)\KeyValue.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(RrManagedDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(RrManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RrManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(RrManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputModule"><HintPath>$(RrManagedDir)\UnityEngine.InputModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(RrManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(RrManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(RrManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(RrManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(RrManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(RrManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(RrManagedDir)\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime"><HintPath>$(RrManagedDir)\Unity.RenderPipelines.Universal.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(RrManagedDir)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Install into the game's Mods folder. Settings.xml there is left alone. -->
  <Target Name="InstallMod" AfterTargets="Build" Condition="Exists('..\Paths.user')">
    <MakeDir Directories="$(ModDirectory)" />
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll;$(OutDir)$(AssemblyName).pdb;Info.json" DestinationFolder="$(ModDirectory)" />
  </Target>
</Project>
