<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unit tests. The mod's classes are internal, so instead of referencing
    WaypointQueue.csproj (whose build also installs the mod) this compiles the
    mod sources together with the tests into one test assembly.

    Run: dotnet test WaypointQueue.Tests/WaypointQueue.Tests.csproj
    The game install folder comes from Paths.user (RrInstallDir).
  -->
  <Import Project="..\Paths.user" Condition="Exists('..\Paths.user')" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>WaypointQueue.Tests</AssemblyName>
    <RootNamespace>WaypointQueue.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RrManagedDir>$(RrInstallDir)\Railroader_Data\Managed</RrManagedDir>
    <WqSource>..\WaypointQueue</WqSource>
  </PropertyGroup>

  <!-- The tests in this folder are included by default; add the mod sources -->
  <ItemGroup>
    <Compile Include="$(WqSource)\**\*.cs" Exclude="$(WqSource)\obj\**;$(WqSource)\bin\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UnityModManager" Version="0.32.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(RrManagedDir)\Assembly-CSharp.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Definition"><HintPath>$(RrManagedDir)\Definition.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="KeyValue.Runtime"><HintPath>$(RrManagedDir)\KeyValue.Runtime.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(RrManagedDir)\Newtonsoft.Json.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(RrManagedDir)\UnityEngine.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RrManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(RrManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine.InputModule"><HintPath>$(RrManagedDir)\UnityEngine.InputModule.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(RrManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(RrManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(RrManagedDir)\UnityEngine.UI.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(RrManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(RrManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(RrManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(RrManagedDir)\Unity.InputSystem.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime"><HintPath>$(RrManagedDir)\Unity.RenderPipelines.Universal.Runtime.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(RrManagedDir)\Unity.TextMeshPro.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>

</Project>
